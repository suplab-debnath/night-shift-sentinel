{
  "name": "@night-shift/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The stage UI (React + Vite).",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:live": "vite --mode live --port 5173 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "e2e": "npm run build:offline && playwright test --project=fast --project=offline && playwright test -c playwright.live.config.ts",
    "e2e:realtime": "playwright test --project=realtime",
    "build:offline": "tsc -p tsconfig.json && vite build --mode offline",
    "demo": "npm run build:offline && vite preview --outDir dist-offline --port 4173 --strictPort",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "build:aws": "tsc -p tsconfig.json && vite build --mode live --outDir dist-aws"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@night-shift/engine": "*",
    "@night-shift/scenarios": "*",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
